# 阿里云短信服务配置
# 速通互联验证码配置

# 阿里云AccessKey配置
ALIYUN_SMS_ACCESS_KEY_ID=LTAI5tCE1PQkahGZ9X93AWLn
ALIYUN_SMS_ACCESS_KEY_SECRET=cTa0iXnw9FBlVNGpff5ipGmIEY3NRm

# 短信签名（已审核通过）
ALIYUN_SMS_SIGN_NAME=速通互联验证码

# 短信模板CODE（已审核通过）
ALIYUN_SMS_TEMPLATE_CODE=100001

# 开发环境设置（设置为development时不会实际发送短信）
# development: 开发环境，不实际发送短信，验证码会在日志中显示
# production: 生产环境，实际发送短信
APP_ENV=development

# 短信发送频率限制（秒）
SMS_SEND_INTERVAL=60
SMS_MAX_DAILY_SENDS=10
SMS_VERIFY_CODE_TTL=300

# 模板参数说明：
# code: 验证码（6位数字）
# min: 有效期（5分钟）
# 模板内容示例：您的验证码是${code}，${min}分钟内有效。