# 阿里云短信服务配置示例
# 复制此文件为 .env.sms 并填写实际配置

# 阿里云AccessKey配置
ALIYUN_SMS_ACCESS_KEY_ID=your_access_key_id_here
ALIYUN_SMS_ACCESS_KEY_SECRET=your_access_key_secret_here

# 短信签名（需要在阿里云控制台审核通过）
ALIYUN_SMS_SIGN_NAME=无敌俱乐部

# 短信模板CODE（需要在阿里云控制台创建）
ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789

# 开发环境设置（设置为development时不会实际发送短信）
APP_ENV=development

# 短信发送频率限制（秒）
SMS_SEND_INTERVAL=60
SMS_MAX_DAILY_SENDS=10
SMS_VERIFY_CODE_TTL=300

# 使用说明：
# 1. 将此文件复制为 .env.sms
# 2. 填写实际的阿里云AccessKey信息
# 3. 在服务器配置中加载此文件
# 4. 生产环境请将APP_ENV设置为production